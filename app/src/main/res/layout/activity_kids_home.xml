<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Header: kid icon on the left, title, gear flush to the right edge (same row as parent). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_child_care"
                    app:tint="@color/primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_md" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/kids_home_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                    android:textColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKidsSettings"
                    style="@style/Widget.Customlockscreen.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingEnd="0dp"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="@dimen/icon_lg"
                    app:iconTint="@color/primary"
                    app:iconGravity="textStart"
                    android:contentDescription="@string/cd_settings" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kids_home_subtitle"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                android:textColor="@color/content_secondary" />

        </LinearLayout>

        <!-- Permissions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/kids_home_section_permissions"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
            android:textColor="@color/content_secondary"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            app:strokeColor="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/tvPermissionProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_home_permission_progress"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textStyle="normal"
                    android:textColor="@color/primary"
                    android:paddingVertical="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_sm" />

                <!-- Admin -->
                <LinearLayout
                    android:id="@+id/btnEnableAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/space_xs"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/primary"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/space_md" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_home_admin"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/content_primary" />

                    <Switch
                        android:id="@+id/switchAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Overlay -->
                <LinearLayout
                    android:id="@+id/btnOverlayPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/space_xs"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_smartphone"
                        app:tint="@color/primary"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/space_md" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_home_overlay"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/content_primary" />

                    <Switch
                        android:id="@+id/switchOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Accessibility -->
                <LinearLayout
                    android:id="@+id/btnAccessibilityService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/space_xs"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_accessibility_new"
                        app:tint="@color/primary"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/space_md" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_home_accessibility"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/content_primary" />

                    <Switch
                        android:id="@+id/switchAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Service toggle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/kids_home_section_service"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
            android:textColor="@color/content_secondary"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnStartService"
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="@color/success_container"
            app:strokeColor="@color/secondary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/secondary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/kids_home_service_subtitle"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/content_secondary"
                        android:lineSpacingMultiplier="0.9" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchLockService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Status -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            app:strokeColor="@color/error">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_home_status_inactive"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/content_secondary"
                    android:drawablePadding="@dimen/space_sm" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pairing -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/kids_home_section_connection"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
            android:textColor="@color/content_secondary"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnPairing"
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="@color/answer_tile"
            app:strokeColor="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_link"
                    app:tint="@color/primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kids_home_pairing_title"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/content_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kids_home_pairing_subtitle"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/content_secondary" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
