<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_home_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Display"
                    android:textColor="@color/kid_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_home_subtitle"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKidsSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/icon_settings"
                android:contentDescription="@string/cd_settings" />

        </LinearLayout>

        <!-- Permissions -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_home_permissions_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/kid_primary"
                    android:layout_marginBottom="@dimen/space_2" />

                <TextView
                    android:id="@+id/tvPermissionProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_home_permission_progress"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textStyle="bold"
                    android:textColor="@color/warning_orange"
                    android:paddingVertical="@dimen/space_1"
                    android:layout_marginBottom="@dimen/space_2" />

                <!-- Admin -->
                <LinearLayout
                    android:id="@+id/btnEnableAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_3"
                    android:background="@drawable/permission_item_background"
                    android:layout_marginBottom="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_lock"
                        android:textSize="@dimen/glyph_md"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/space_3" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_home_admin"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Overlay -->
                <LinearLayout
                    android:id="@+id/btnOverlayPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_3"
                    android:background="@drawable/permission_item_background"
                    android:layout_marginBottom="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_phone"
                        android:textSize="@dimen/glyph_md"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/space_3" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_home_overlay"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Accessibility -->
                <LinearLayout
                    android:id="@+id/btnAccessibilityService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_3"
                    android:background="@drawable/permission_item_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_accessibility"
                        android:textSize="@dimen/glyph_md"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/space_3" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_home_accessibility"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Service toggle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/success_light"
            app:strokeWidth="2dp"
            app:strokeColor="@color/success">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_lock"
                    android:textSize="@dimen/glyph_lg"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kids_home_service_title"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kids_home_service_subtitle"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchLockService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_home_status_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_1" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_home_status_inactive"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pairing -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnPairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_6"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/answer_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_link"
                    android:textSize="@dimen/glyph_lg"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kids_home_pairing_title"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                        android:textColor="@color/primary_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kids_home_pairing_subtitle"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_chevron_right"
                    android:textSize="@dimen/glyph_lg"
                    android:textColor="@color/primary_blue"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
