<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPack"
    style="@style/Widget.Customlockscreen.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_sm">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPackName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pack_item_name_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                android:textColor="@color/content_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPackCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pack_item_category_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Xs"
                android:textColor="@color/content_primary"
                android:background="@drawable/category_badge"
                android:drawablePadding="@dimen/space_xs"
                app:drawableTint="@color/content_primary"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs" />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvPackDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pack_item_desc_placeholder"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/content_secondary"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvPackInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pack_item_info_placeholder"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
            android:textColor="@color/content_hint"
            android:layout_marginBottom="@dimen/space_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            style="@style/Widget.Customlockscreen.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pack_item_download"
            app:icon="@drawable/ic_download"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
