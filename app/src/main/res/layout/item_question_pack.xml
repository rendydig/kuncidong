<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPack"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_2">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPackName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pack_item_name_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                android:textColor="@color/text_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPackCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pack_item_category_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                android:textColor="@color/white"
                android:background="@drawable/category_badge"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1" />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvPackDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pack_item_desc_placeholder"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/space_2" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvPackInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pack_item_info_placeholder"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="@dimen/space_3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/pack_item_download"
            android:textSize="@dimen/text_body"
            app:backgroundTint="@color/success"
            app:cornerRadius="@dimen/radius_sm"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
