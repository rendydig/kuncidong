<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_5"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_title"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Display"
            android:textColor="@color/kid_primary"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginBottom="@dimen/space_2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_subtitle"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
            android:textStyle="normal"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:layout_marginBottom="@dimen/space_6" />

        <!-- Parent role -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardParent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_parent"
                    android:textSize="@dimen/glyph_xl"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_4" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_parent"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                        android:textColor="@color/kid_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_parent_desc"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_chevron_right"
                    android:textSize="@dimen/glyph_lg"
                    android:textColor="@color/primary_blue"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Kids role -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_kid"
                    android:textSize="@dimen/glyph_xl"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_4" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_kids"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                        android:textColor="@color/kid_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_kids_desc"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_chevron_right"
                    android:textSize="@dimen/glyph_lg"
                    android:textColor="@color/primary_blue"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_footer"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/space_2" />

    </LinearLayout>

</ScrollView>
