<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="@dimen/icon_hero"
            android:layout_height="@dimen/icon_hero"
            android:src="@drawable/ic_lock"
            app:tint="@color/primary"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_marginTop="@dimen/space_lg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_title"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Display"
            android:textColor="@color/primary"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_subtitle"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
            android:textStyle="normal"
            android:textColor="@color/content_secondary"
            android:textAlignment="center"
            android:layout_marginBottom="@dimen/space_lg" />

        <!-- Parent role -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardParent"
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:src="@drawable/ic_family_restroom"
                    app:tint="@color/primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_parent"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_parent_desc"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                        android:textColor="@color/content_secondary" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Kids role -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKids"
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:src="@drawable/ic_child_care"
                    app:tint="@color/primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_kids"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_kids_desc"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                        android:textColor="@color/content_secondary" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_footer"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/content_secondary"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/space_sm" />

    </LinearLayout>

</ScrollView>
