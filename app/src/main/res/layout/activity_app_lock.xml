<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/gradient_background"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔐"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Aplikasi Terkunci"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/kid_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Masukkan PIN Aplikasi untuk membuka"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etAppPin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:hint="PIN"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:letterSpacing="0.3"
                android:maxLength="12" />

            <TextView
                android:id="@+id/tvAppPinError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/error_red"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="PIN salah. Coba lagi." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppPinUnlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Buka"
                android:textAllCaps="false" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
