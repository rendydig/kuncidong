<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/gradient_background"
    android:padding="@dimen/space_lg">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Customlockscreen.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/space_lg">

            <ImageView
                android:layout_width="@dimen/icon_hero"
                android:layout_height="@dimen/icon_hero"
                android:src="@drawable/ic_lock"
                app:tint="@color/primary"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/app_lock_title"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                android:textColor="@color/primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_md"
                android:gravity="center"
                android:text="@string/app_lock_subtitle"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                android:textColor="@color/content_secondary" />

            <EditText
                android:id="@+id/etAppPin"
                style="@style/Widget.Customlockscreen.EditText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:hint="@string/app_lock_pin_hint"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:letterSpacing="0.3"
                android:maxLength="12" />

            <TextView
                android:id="@+id/tvAppPinError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                android:textColor="@color/error_text"
                android:visibility="gone"
                tools:text="PIN salah. Coba lagi." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppPinUnlock"
                style="@style/Widget.Customlockscreen.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/app_lock_unlock" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
