<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/gradient_background"
    android:padding="@dimen/space_6">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/space_6">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_lock_icon"
                android:textSize="@dimen/glyph_hero"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/app_lock_title"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                android:textColor="@color/kid_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:layout_marginBottom="@dimen/space_4"
                android:gravity="center"
                android:text="@string/app_lock_subtitle"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etAppPin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:hint="@string/app_lock_pin_hint"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:letterSpacing="0.3"
                android:maxLength="12" />

            <TextView
                android:id="@+id/tvAppPinError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                android:textColor="@color/error_red"
                android:visibility="gone"
                tools:text="PIN salah. Coba lagi." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppPinUnlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/app_lock_unlock"
                android:textAllCaps="false" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
