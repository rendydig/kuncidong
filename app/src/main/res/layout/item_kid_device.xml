<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_3">

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvKidName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kid_device_name_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvKidAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kid_device_address_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvKidStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kid_device_status_paired"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                android:textStyle="bold"
                android:textColor="@color/success" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLock"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/space_3"
            android:text="@string/kid_device_lock"
            android:textSize="@dimen/text_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/space_2"
            android:text="@string/kid_device_unlock"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/btnRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="@string/icon_remove"
            android:gravity="center"
            android:textSize="@dimen/glyph_sm"
            android:textColor="@color/error_red"
            android:contentDescription="@string/cd_remove_device" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
