<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_5"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_screen_text_icon"
            android:textSize="@dimen/glyph_hero"
            android:importantForAccessibility="no"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_2" />

        <TextView
            android:id="@+id/tvTextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_screen_text_title"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
            android:textColor="@color/kid_primary"
            android:textAlignment="center"
            android:layout_marginBottom="@dimen/space_4" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_5"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface_card">

            <TextView
                android:id="@+id/tvTextMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_6"
                android:text="@string/lock_screen_text_message_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                android:textStyle="normal"
                android:textColor="@color/text_primary"
                android:textAlignment="center"
                android:lineSpacingExtra="6dp" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lock_screen_text_pin_prompt"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"
                    android:layout_marginBottom="@dimen/space_2" />

                <EditText
                    android:id="@+id/etUnlockPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lock_screen_text_pin_hint"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:gravity="center"
                    android:textSize="@dimen/text_title" />

                <Button
                    android:id="@+id/btnPinUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:backgroundTint="@color/primary_blue"
                    android:textColor="@color/white"
                    android:text="@string/lock_screen_text_unlock"
                    android:contentDescription="@string/cd_unlock_with_pin"
                    android:textAllCaps="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnWaitParent"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:text="@string/lock_screen_text_wait"
            android:contentDescription="@string/cd_wait_for_parent"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
