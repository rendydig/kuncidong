<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lock_screen_background"
    android:gravity="center">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Lock Screen"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary_blue"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Answer the question to unlock"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <!-- Question Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/question_background"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mathematics"
                android:textSize="12sp"
                android:textColor="@color/secondary_green"
                android:textStyle="bold"
                android:background="@drawable/category_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvQuestion"
                style="@style/QuestionText"
                android:text="What is 15 + 27?"
                android:layout_marginBottom="0dp"
                android:padding="0dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Answer Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <Button
            android:id="@+id/btnAnswer1"
            style="@style/AnswerButton"
            android:text="42"
            android:layout_marginHorizontal="0dp" />

        <Button
            android:id="@+id/btnAnswer2"
            style="@style/AnswerButton"
            android:text="41"
            android:layout_marginHorizontal="0dp" />

        <Button
            android:id="@+id/btnAnswer3"
            style="@style/AnswerButton"
            android:text="43"
            android:layout_marginHorizontal="0dp" />

        <Button
            android:id="@+id/btnAnswer4"
            style="@style/AnswerButton"
            android:text="40"
            android:layout_marginHorizontal="0dp" />

    </LinearLayout>

    <!-- Feedback Text -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="24dp"
        android:visibility="gone" />

    <!-- Time Display -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/primary_blue"
        android:textAlignment="center"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:layout_marginTop="8dp" />

</LinearLayout>
