<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        android:gravity="center">

        <!-- Goal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_md">

            <TextView
                android:id="@+id/tvUnlockGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kid_unlock_goal"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                android:textColor="@color/content_primary" />

            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:src="@drawable/ic_lock_open"
                app:tint="@color/content_primary"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/space_sm" />

        </LinearLayout>

        <!-- Question Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            app:strokeColor="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_md">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_psychology"
                        app:tint="@color/primary"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/space_md" />

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lock_screen_category_placeholder"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lock_screen_question_placeholder"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                    android:textColor="@color/content_primary"
                    android:textAlignment="center"
                    android:padding="@dimen/space_md"
                    android:background="@drawable/question_box_background"
                    android:layout_marginTop="@dimen/space_sm" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Answer Buttons Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            app:strokeColor="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lock_screen_answer_prompt"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/content_primary"
                    android:textAlignment="center"
                    android:layout_marginBottom="@dimen/space_md" />

                <!-- Answer Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/space_md">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAnswer1"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:cardElevation="@dimen/elevation_sm"
                        app:cardBackgroundColor="@color/answer_tile"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp">

                        <TextView
                            android:id="@+id/tvAnswer1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/lock_screen_answer_placeholder"
                            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                            android:textColor="@color/content_primary"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAnswer2"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:cardElevation="@dimen/elevation_sm"
                        app:cardBackgroundColor="@color/answer_tile"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp">

                        <TextView
                            android:id="@+id/tvAnswer2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/lock_screen_answer_placeholder"
                            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                            android:textColor="@color/content_primary"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAnswer3"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:cardElevation="@dimen/elevation_sm"
                        app:cardBackgroundColor="@color/answer_tile"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp">

                        <TextView
                            android:id="@+id/tvAnswer3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/lock_screen_answer_placeholder"
                            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                            android:textColor="@color/content_primary"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAnswer4"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:cardElevation="@dimen/elevation_sm"
                        app:cardBackgroundColor="@color/answer_tile"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp">

                        <TextView
                            android:id="@+id/tvAnswer4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/lock_screen_answer_placeholder"
                            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                            android:textColor="@color/content_primary"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Feedback Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/feedbackCard"
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/tvFeedbackIcon"
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/success"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_md" />

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/content_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
