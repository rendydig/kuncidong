<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="32dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="App Icon" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smartlock untuk Anak-anak"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary_blue"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Layar Kunci Edukatif untuk Anak-anak"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jawab pertanyaan untuk membuka kunci"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnEnableAdmin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Aktifkan Admin Perangkat"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/answer_button_selector"
        android:layout_marginBottom="16dp"
        android:elevation="4dp" />

    <Button
        android:id="@+id/btnOverlayPermission"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Izinkan Tampilan Over Apps"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/answer_button_selector"
        android:layout_marginBottom="16dp"
        android:elevation="4dp" />

    <Button
        android:id="@+id/btnAccessibilityService"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Aktifkan Layanan Aksesibilitas"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/answer_button_selector"
        android:layout_marginBottom="16dp"
        android:elevation="4dp" />

    <Button
        android:id="@+id/btnStartService"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Mulai Layanan Layar Kunci"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/answer_button_selector"
        android:layout_marginBottom="16dp"
        android:elevation="4dp" />

    <Button
        android:id="@+id/btnTestLockScreen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🧪 Test Layar Kunci (Debug)"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/answer_button_selector"
        android:layout_marginBottom="16dp"
        android:elevation="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:padding="16dp"
        android:background="@drawable/status_background">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="❌ Status: Not configured"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Tips: Kunci perangkat Anda untuk menguji layar kunci edukasi"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        android:padding="8dp" />

</LinearLayout>

</ScrollView>
