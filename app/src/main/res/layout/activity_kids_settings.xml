<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/icon_back"
                android:contentDescription="@string/cd_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/kids_settings_title"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                android:textColor="@color/kid_primary" />

        </LinearLayout>

        <!-- Timer -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_timer_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_2" />

                <Spinner
                    android:id="@+id/spinnerTimerInterval"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/spinner_background" />

                <TextView
                    android:id="@+id/tvTimerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_timer_status"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/space_2" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Default local mode -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_mode_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_1" />

                <RadioGroup
                    android:id="@+id/radioDefaultMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbDefaultQuiz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_settings_mode_quiz" />

                    <RadioButton
                        android:id="@+id/rbDefaultText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_settings_mode_text" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_mode_hint"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PIN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_pin_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_1" />

                <TextView
                    android:id="@+id/tvPinStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_pin_unset"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="@dimen/space_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePin"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_pin_change"
                    android:textAllCaps="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PIN Aplikasi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_app_pin_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_1" />

                <TextView
                    android:id="@+id/tvAppPinStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_app_pin_unset"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="@dimen/space_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeAppPin"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_app_pin_change"
                    android:textAllCaps="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Parents -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_parents_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_2" />

                <TextView
                    android:id="@+id/tvNoParentsSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_parents_empty"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:id="@+id/llParentsSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Other actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageQuestions"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/kids_settings_manage_questions"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestLock"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/kids_settings_test_lock"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchRole"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_6"
            android:text="@string/kids_settings_switch_role"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
