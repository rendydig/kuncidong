<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Customlockscreen.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_sm"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/primary"
                android:contentDescription="@string/cd_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/kids_settings_title"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                android:textColor="@color/primary"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="@dimen/space_sm"
                app:drawableTint="@color/primary" />

        </LinearLayout>

        <!-- Timer -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_timer_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/content_primary"
                    android:drawableStart="@drawable/ic_alarm"
                    android:drawablePadding="@dimen/space_sm"
                    app:drawableTint="@color/primary"
                    android:layout_marginBottom="@dimen/space_sm" />

                <Spinner
                    android:id="@+id/spinnerTimerInterval"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/spinner_background" />

                <TextView
                    android:id="@+id/tvTimerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_timer_status"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/content_secondary"
                    android:layout_marginTop="@dimen/space_sm" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Default local mode -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_mode_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/content_primary"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="@dimen/space_sm"
                    app:drawableTint="@color/primary"
                    android:layout_marginBottom="@dimen/space_xs" />

                <RadioGroup
                    android:id="@+id/radioDefaultMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbDefaultQuiz"
                        style="@style/Widget.Customlockscreen.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_settings_mode_quiz"
                        android:drawableStart="@drawable/ic_psychology"
                        android:drawablePadding="@dimen/space_xs"
                        app:drawableTint="@color/secondary" />

                    <RadioButton
                        android:id="@+id/rbDefaultText"
                        style="@style/Widget.Customlockscreen.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kids_settings_mode_text"
                        android:drawableStart="@drawable/ic_chat_bubble"
                        android:drawablePadding="@dimen/space_xs"
                        app:drawableTint="@color/secondary" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_mode_hint"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/content_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PIN -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_pin_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/content_primary"
                    android:drawableStart="@drawable/ic_key"
                    android:drawablePadding="@dimen/space_sm"
                    app:drawableTint="@color/primary"
                    android:layout_marginBottom="@dimen/space_xs" />

                <TextView
                    android:id="@+id/tvPinStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_pin_unset"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/content_secondary"
                    android:layout_marginBottom="@dimen/space_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePin"
                    style="@style/Widget.Customlockscreen.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_pin_change" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PIN Aplikasi -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_app_pin_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/content_primary"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="@dimen/space_sm"
                    app:drawableTint="@color/primary"
                    android:layout_marginBottom="@dimen/space_xs" />

                <TextView
                    android:id="@+id/tvAppPinStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_app_pin_unset"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                    android:textColor="@color/content_secondary"
                    android:layout_marginBottom="@dimen/space_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeAppPin"
                    style="@style/Widget.Customlockscreen.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_app_pin_change" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Parents -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_parents_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/content_primary"
                    android:drawableStart="@drawable/ic_family_restroom"
                    android:drawablePadding="@dimen/space_sm"
                    app:drawableTint="@color/primary"
                    android:layout_marginBottom="@dimen/space_sm" />

                <TextView
                    android:id="@+id/tvNoParentsSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kids_settings_parents_empty"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                    android:textColor="@color/content_secondary" />

                <LinearLayout
                    android:id="@+id/llParentsSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Other actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageQuestions"
            style="@style/Widget.Customlockscreen.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/kids_settings_manage_questions"
            app:icon="@drawable/ic_menu_book"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestLock"
            style="@style/Widget.Customlockscreen.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/kids_settings_test_lock"
            app:icon="@drawable/ic_science"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchRole"
            style="@style/Widget.Customlockscreen.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:text="@string/kids_settings_switch_role" />

    </LinearLayout>

</ScrollView>
