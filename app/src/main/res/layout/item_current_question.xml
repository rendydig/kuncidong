<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_2">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvQuestionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question_item_number_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"
                android:background="@drawable/number_badge"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1"
                android:layout_marginEnd="@dimen/space_2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvQuestionCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question_item_category_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                android:textColor="@color/white"
                android:background="@drawable/category_badge"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1" />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/question_item_text_placeholder"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/question_item_answer_placeholder"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
            android:textColor="@color/success"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
