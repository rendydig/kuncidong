<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Customlockscreen.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_sm">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvQuestionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question_item_number_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Xs"
                android:textColor="@color/primary"
                android:background="@drawable/number_badge"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_sm" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvQuestionCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question_item_category_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Xs"
                android:textColor="@color/content_primary"
                android:background="@drawable/category_badge"
                android:drawablePadding="@dimen/space_xs"
                app:drawableTint="@color/content_primary"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs" />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/question_item_text_placeholder"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/content_primary"
            android:layout_marginBottom="@dimen/space_xs" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/question_item_answer_placeholder"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
            android:textColor="@color/success_text"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
