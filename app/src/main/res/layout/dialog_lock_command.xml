<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <TextView
        android:id="@+id/tvLockTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lock_dialog_title"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
        android:textColor="@color/content_primary"
        android:layout_marginBottom="@dimen/space_md" />

    <RadioGroup
        android:id="@+id/radioMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="@dimen/space_md">

        <RadioButton
            android:id="@+id/rbQuiz"
            style="@style/Widget.Customlockscreen.RadioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:checked="true"
            android:text="@string/lock_dialog_mode_quiz"
            android:drawableStart="@drawable/ic_psychology"
            android:drawablePadding="@dimen/space_xs"
            app:drawableTint="@color/secondary" />

        <RadioButton
            android:id="@+id/rbText"
            style="@style/Widget.Customlockscreen.RadioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lock_dialog_mode_text"
            android:drawableStart="@drawable/ic_chat_bubble"
            android:drawablePadding="@dimen/space_xs"
            app:drawableTint="@color/secondary" />

    </RadioGroup>

    <LinearLayout
        android:id="@+id/textSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_dialog_templates_label"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/content_secondary"
            android:layout_marginBottom="@dimen/space_sm" />

        <Spinner
            android:id="@+id/spinnerTemplate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:layout_marginBottom="@dimen/space_md" />

        <EditText
            android:id="@+id/etTitle"
            style="@style/Widget.Customlockscreen.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:hint="@string/lock_dialog_title_hint"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etText"
            style="@style/Widget.Customlockscreen.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lock_dialog_text_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

    </LinearLayout>

</LinearLayout>
