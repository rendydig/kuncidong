<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_5">

    <TextView
        android:id="@+id/tvLockTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lock_dialog_title"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/space_3" />

    <RadioGroup
        android:id="@+id/radioMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbQuiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/lock_dialog_mode_quiz" />

        <RadioButton
            android:id="@+id/rbText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lock_dialog_mode_text" />

    </RadioGroup>

    <LinearLayout
        android:id="@+id/textSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="@dimen/space_2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_dialog_templates_label"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/spinnerTemplate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:layout_marginBottom="@dimen/space_2" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lock_dialog_title_hint"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lock_dialog_text_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

    </LinearLayout>

</LinearLayout>
