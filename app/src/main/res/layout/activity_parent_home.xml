<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:padding="@dimen/space_md">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:src="@drawable/ic_family_restroom"
                    app:tint="@color/primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/parent_home_title"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Display"
                    android:textColor="@color/primary" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/parent_home_subtitle"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                android:textColor="@color/content_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParentSettings"
            style="@style/Widget.Customlockscreen.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/space_sm"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/primary"
            android:contentDescription="@string/cd_settings" />

    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            style="@style/Widget.Customlockscreen.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@string/parent_home_scan"
            app:icon="@drawable/ic_search"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTemplates"
            style="@style/Widget.Customlockscreen.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/parent_home_templates"
            app:icon="@drawable/ic_edit_note"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvScanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/parent_home_scan_hint"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
        android:textColor="@color/content_secondary"
        android:layout_marginBottom="@dimen/space_md" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/parent_home_empty"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
        android:textAlignment="center"
        android:textColor="@color/content_secondary"
        android:padding="@dimen/space_lg"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKids"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLockSelected"
        style="@style/Widget.Customlockscreen.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/parent_home_lock_selected"
        app:icon="@drawable/ic_lock"
        app:iconTint="@color/white"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_sm"
        android:visibility="gone" />

</LinearLayout>
