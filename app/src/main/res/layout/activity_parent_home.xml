<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:padding="@dimen/space_md">

    <!-- Header: parent icon on the left, title centred, gear flush to the right edge. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_md">

        <ImageView
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:src="@drawable/ic_family_restroom"
            app:tint="@color/primary"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/space_md" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/parent_home_title"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                android:textColor="@color/primary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParentSettings"
            style="@style/Widget.Customlockscreen.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:insetRight="0dp"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="0dp"
            app:icon="@drawable/ic_settings"
            app:iconSize="@dimen/icon_lg"
            app:iconTint="@color/primary"
            app:iconGravity="textStart"
            android:contentDescription="@string/cd_settings" />

    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            style="@style/Widget.Customlockscreen.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@string/parent_home_scan"
            app:icon="@drawable/ic_search"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTemplates"
            style="@style/Widget.Customlockscreen.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/parent_home_templates"
            app:icon="@drawable/ic_edit_note"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvScanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/parent_home_scan_hint"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
        android:textColor="@color/content_secondary"
        android:layout_marginBottom="@dimen/space_md" />

    <!-- Device list, with the empty message centred in the list area. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvKids"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/parent_home_empty"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textAlignment="center"
            android:textColor="@color/content_secondary"
            android:padding="@dimen/space_lg"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLockSelected"
        style="@style/Widget.Customlockscreen.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/parent_home_lock_selected"
        app:icon="@drawable/ic_lock"
        app:iconTint="@color/white"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_sm"
        android:visibility="gone" />

</LinearLayout>
