<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Customlockscreen.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTemplateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/template_item_title_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                android:textColor="@color/content_primary" />

            <TextView
                android:id="@+id/tvTemplateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/template_item_text_placeholder"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                android:textColor="@color/content_secondary"
                android:maxLines="3"
                android:ellipsize="end" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnDeleteTemplate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_sm"
            android:src="@drawable/ic_delete"
            android:padding="@dimen/space_sm"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="@color/destructive"
            android:contentDescription="@string/cd_delete_template" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
