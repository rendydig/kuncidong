<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <TextView
        android:id="@+id/tvPairDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pair_dialog_title"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
        android:textColor="@color/content_primary"
        android:layout_marginBottom="@dimen/space_xs" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pair_dialog_instructions"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
        android:textColor="@color/content_secondary"
        android:layout_marginBottom="@dimen/space_md" />

    <EditText
        android:id="@+id/etPairCode"
        style="@style/Widget.Customlockscreen.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:hint="@string/pair_dialog_code_hint"
        android:inputType="number"
        android:maxLength="6"
        android:letterSpacing="0.3" />

    <EditText
        android:id="@+id/etPairPin"
        style="@style/Widget.Customlockscreen.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:hint="@string/pair_dialog_pin_hint"
        android:inputType="numberPassword"
        android:maxLength="8" />

    <EditText
        android:id="@+id/etParentName"
        style="@style/Widget.Customlockscreen.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:hint="@string/pair_dialog_name_hint"
        android:inputType="textPersonName"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pair_dialog_pin_note"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
        android:textColor="@color/content_secondary" />

</LinearLayout>
