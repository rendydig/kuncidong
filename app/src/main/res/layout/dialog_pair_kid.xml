<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_5">

    <TextView
        android:id="@+id/tvPairDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pair_dialog_title"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/space_1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pair_dialog_instructions"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="@dimen/space_3" />

    <EditText
        android:id="@+id/etPairCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pair_dialog_code_hint"
        android:inputType="number"
        android:maxLength="6"
        android:letterSpacing="0.3" />

    <EditText
        android:id="@+id/etPairPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pair_dialog_pin_hint"
        android:inputType="numberPassword"
        android:maxLength="8" />

    <EditText
        android:id="@+id/etParentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pair_dialog_name_hint"
        android:inputType="textPersonName"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pair_dialog_pin_note"
        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/space_2" />

</LinearLayout>
