<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:padding="@dimen/space_md">

    <!-- Header -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Customlockscreen.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_menu_book"
                    app:tint="@color/primary_dark"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/question_manager_title"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                        android:textColor="@color/primary_dark" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/question_manager_subtitle"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                        android:textColor="@color/content_secondary"
                        android:layout_marginTop="@dimen/space_xs" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Available Question Packs -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Customlockscreen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_md">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/question_manager_packs_title"
                            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                            android:textColor="@color/primary_dark"
                            android:drawableStart="@drawable/ic_cloud_download"
                            android:drawablePadding="@dimen/space_sm"
                            app:drawableTint="@color/primary_dark" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRefreshPacks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/question_manager_refresh"
                            android:textSize="@dimen/text_label"
                            app:icon="@drawable/ic_refresh"
                            app:iconTint="@color/primary"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_xs"
                            style="@style/Widget.Customlockscreen.Button.Text" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvPacksCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/question_manager_loading"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/content_secondary"
                        android:layout_marginBottom="@dimen/space_md" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAvailablePacks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Current Questions -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCurrentQuestions"
                style="@style/Widget.Customlockscreen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_md">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/question_manager_current_title"
                            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                            android:textColor="@color/primary_dark"
                            android:drawableStart="@drawable/ic_edit_note"
                            android:drawablePadding="@dimen/space_sm"
                            app:drawableTint="@color/primary_dark" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvCurrentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/question_manager_loading"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/content_secondary"
                        android:layout_marginBottom="@dimen/space_md" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCurrentQuestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:maxHeight="300dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Button -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Customlockscreen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewCurrent"
                        style="@style/Widget.Customlockscreen.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/question_manager_view_current"
                        android:textSize="@dimen/text_heading"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_list"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
