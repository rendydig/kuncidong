<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:padding="@dimen/space_4">

    <!-- Header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        app:cardCornerRadius="@dimen/radius_sm"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/question_manager_icon"
                    android:textSize="@dimen/glyph_lg"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/space_3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/question_manager_title"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                        android:textColor="@color/primary_blue_dark" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/question_manager_subtitle"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="@dimen/space_1" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Available Question Packs -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                app:cardCornerRadius="@dimen/radius_sm"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_4">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/question_manager_packs_title"
                            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                            android:textColor="@color/primary_blue_dark" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRefreshPacks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/question_manager_refresh"
                            android:textSize="@dimen/text_label"
                            style="@style/Widget.Material3.Button.TextButton"
                            app:cornerRadius="@dimen/radius_sm" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvPacksCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/question_manager_loading"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/space_3" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAvailablePacks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Current Questions -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCurrentQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_sm"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_4">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/question_manager_current_title"
                            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                            android:textColor="@color/primary_blue_dark" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvCurrentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/question_manager_loading"
                        android:textAppearance="@style/TextAppearance.Customlockscreen.Label"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/space_3" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCurrentQuestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:maxHeight="300dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_sm"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/question_manager_view_current"
                        android:textSize="@dimen/text_heading"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary_blue"
                        app:cornerRadius="@dimen/radius_sm"
                        app:icon="@drawable/ic_list"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
