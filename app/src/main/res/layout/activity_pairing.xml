<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Customlockscreen.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_sm"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/primary"
                android:contentDescription="@string/cd_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pairing_title"
                android:textAppearance="@style/TextAppearance.Customlockscreen.Title"
                android:textColor="@color/primary"
                android:drawableStart="@drawable/ic_link"
                android:drawablePadding="@dimen/space_sm"
                app:drawableTint="@color/primary" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Customlockscreen.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pairing_device_placeholder"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
                    android:textColor="@color/content_secondary"
                    android:layout_marginBottom="@dimen/space_sm" />

                <TextView
                    android:id="@+id/tvPairCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pairing_code_placeholder"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="@dimen/space_sm" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pairing_countdown_placeholder"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                    android:textColor="@color/warning_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pairing_instructions"
                    android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
                    android:textAlignment="center"
                    android:textColor="@color/content_secondary"
                    android:layout_marginTop="@dimen/space_md" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pairing_parents_title"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Heading"
            android:textColor="@color/primary"
            android:drawableStart="@drawable/ic_family_restroom"
            android:drawablePadding="@dimen/space_sm"
            app:drawableTint="@color/primary"
            android:layout_marginBottom="@dimen/space_sm" />

        <TextView
            android:id="@+id/tvNoParents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pairing_parents_empty"
            android:textAppearance="@style/TextAppearance.Customlockscreen.Body"
            android:textColor="@color/content_secondary"
            android:padding="@dimen/space_sm" />

        <LinearLayout
            android:id="@+id/llParents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
