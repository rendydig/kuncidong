<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: 3dp coral border with a coral focus ring. -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary_alpha_20" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_base" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/primary" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Hovered (pointer devices): border strengthens. -->
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_base" />
            <stroke
                android:width="2dp"
                android:color="@color/input_border_hover" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_base" />
            <stroke
                android:width="2dp"
                android:color="@color/input_border" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
