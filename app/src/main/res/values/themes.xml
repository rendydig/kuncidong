<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Light-only: the app has no dark variant by design. -->
    <style name="Base.Theme.Customlockscreen" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/success</item>
        <item name="colorSecondaryVariant">@color/success_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/primary_blue</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="fontFamily">@font/nunito</item>
    </style>

    <style name="Theme.Customlockscreen" parent="Base.Theme.Customlockscreen" />

    <!-- Main Activity Theme without Action Bar -->
    <style name="Theme.Customlockscreen.NoActionBar" parent="Base.Theme.Customlockscreen">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Lock Screen Theme -->
    <style name="Theme.Customlockscreen.LockScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/lock_screen_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="fontFamily">@font/nunito</item>
    </style>

    <!-- Type scale -->
    <style name="TextAppearance.Customlockscreen.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/fredoka_one</item>
    </style>

    <style name="TextAppearance.Customlockscreen.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>

    <style name="TextAppearance.Customlockscreen.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>

    <style name="TextAppearance.Customlockscreen.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>

    <style name="TextAppearance.Customlockscreen.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>

    <!-- Button Styles -->
    <style name="AnswerButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginHorizontal">@dimen/space_4</item>
        <item name="android:layout_marginVertical">@dimen/space_2</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/answer_button_selector</item>
        <item name="android:elevation">4dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Text Styles -->
    <style name="QuestionText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/question_text</item>
        <item name="android:textAlignment">center</item>
        <item name="android:padding">@dimen/space_6</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
